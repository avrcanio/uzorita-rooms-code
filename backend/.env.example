# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Postgres/PostGIS (hetzner_net; lokalni alati i dalje mogu 127.0.0.1:5432)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgis
DB_PORT=5432

# Celery (infra-redis DB 1)
CELERY_BROKER_URL=redis://infra-redis:6379/1
CELERY_RESULT_BACKEND=redis://infra-redis:6379/1

DJANGO_CSRF_TRUSTED_ORIGINS=https://rooms.uzorita.hr

# Mailbox — Docker-mailserver (TLS hostname = MAIL_HOSTNAME u mailserver stacku)
MAILBOX_EMAIL=room_reservations@uzorita.hr
MAILBOX_PASSWORD=change-me-on-mailserver
# Docker mailserver (hetzner_net): TCP na kontejner, TLS SNI na javni hostname certa.
IMAP_CONNECT_HOST=mailserver
IMAP_TLS_SERVERNAME=mail.finestar.hr
IMAP_HOST=mail.finestar.hr
IMAP_PORT=993
IMAP_USE_SSL=1
IMAP_FOLDER=INBOX
SMTP_HOST=mail.finestar.hr
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_USE_TLS=0
SMTP_USER=room_reservations@uzorita.hr
SMTP_PASSWORD=change-me-on-mailserver

# PaddleOCR FastAPI (hetzner_net service name)
PADDLE_OCR_BASE_URL=http://paddle-ocr-fastapi:8866
PADDLE_OCR_PREDICT_PATH=/predict
PADDLE_OCR_FILE_FIELD=file
PADDLE_OCR_TIMEOUT_SECONDS=90
PADDLE_OCR_REQUEST_FORMAT=json_images
# MRZ / OCR: SCAN_OCR_TRACE_LOG=1 → Django log (reception.scan, mrz_pipeline, OCRService).
# OCR_TRACE_LOG=1 → Paddle kontejner log (predict po liniji). U produkciji stavi 0.
SCAN_OCR_TRACE_LOG=1
OCR_TRACE_LOG=1
# OCR uzorci (original upload): default media/id_documents (MEDIA_ROOT). Prazno = ne spremaj.
# Sadrži osobne podatke — u produkciji postavi SCAN_OCR_SAMPLE_DIR= ; cijeli backend/app/media/ je u .gitignore.
SCAN_OCR_SAMPLE_DIR=media/id_documents
# MRZ (HR osobna poleđina = TD1, 3 linije ~30 znakova, puno '<'): backend uzima OCR linije
# duge >=20 znakova i probava TD3/TD2/TD1. Ako OCR vidi samo tekst iznad MRZ-a, MRZ neće
# proći — snimaj donji dio karte, dovoljna oštrina, bez jakog refleksa; u aplikaciji crop na MRZ.
# Drugi prolaz Paddlea na donjem MRZ izrezu (merge s punim kadrom): MRZ_OCR_SECOND_PASS=0 isključuje.
MRZ_OCR_SECOND_PASS=1
MRZ_CROP_HEIGHT_RATIO=0.32
MRZ_CROP_PREPROCESS=1
MRZ_CROP_MERGE_MARGIN_PX=8
# Smanji MRZ crop prije OpenCV (preporuka 1200–2000; 0=isključeno). Pomaže protiv Cloudflare timeouta.
MRZ_CROP_MAX_LONG_EDGE=1600
# Gornja granica piksela nakon upscale-a (nh*nw*up^2); ako je previsoko, upscale se automatski snizi.
MRZ_CROP_MAX_PIXELS_AFTER_UPSCALE=5000000
# Spremanje 4 MRZ debug JPG uz sken (sinkrono); 0=isključeno, 1=uključeno. Za produkciju ostavi 0.
MRZ_CROP_DEBUG_IMAGES=0
# Ako ROI + Paddle i dalje ne zadovoljavaju: sljedeći korak je odvojeni PR (Tesseract OCR-B ili SDK npr. BlinkID).

# eVisitor (test: https://www.evisitor.hr/test — zasebni pristupni podaci od produkcije)
EVISITOR_ENABLED=false
EVISITOR_ENV=test
EVISITOR_BASE_URL=https://www.evisitor.hr/testApi
EVISITOR_USERNAME=
EVISITOR_PASSWORD=
EVISITOR_API_KEY=
EVISITOR_FACILITY_CODE=
# Opcionalno (defaulti u settings/base.py): EVISITOR_DEFAULT_ARRIVAL_ORGANISATION=O
# EVISITOR_DEFAULT_OFFERED_SERVICE_TYPE=noćenje
# EVISITOR_DEFAULT_PAYMENT_CATEGORY=11
# EVISITOR_DEFAULT_STAY_TIME_FROM=14:00
# EVISITOR_DEFAULT_STAY_TIME_UNTIL=10:00

# Booking.com extranet (Playwright session; lozinka i LOGIN_URL samo u .env na serveru)
BOOKING_EXTRANET_ENABLED=true
BOOKING_EXTRANET_USERNAME=hospira
BOOKING_EXTRANET_PASSWORD=
# Pun URL s op_token iz extraneta (Manage → Reservations); token može isteći
BOOKING_EXTRANET_LOGIN_URL=https://account.booking.com/sign-in?op_token=EgVvYXV0aCKyAQoUNlo3Mm9IT2QzNk5uN3prM3BpcmgSCWF1dGhvcml6ZRoaaHR0cHM6Ly9hZG1pbi5ib29raW5nLmNvbS8qOnsiYXV0aF9hdHRlbXB0X2lkIjoiYjk2NTgyMWEtMTNhNi00ZTI1LWI5YTgtNTc4ZmIzYTgyODI0In0yK0xGZzRIMjBVRUZQQkROeXNlT25iSmNDRUFUa1d6Q2JGUml3TW1ocHYtblE6BFMyNTZCBGNvZGUqEzD2lN3Q1bkoOgBCAFjiiIuz4zM
BOOKING_EXTRANET_HOTEL_ID=4181954
BOOKING_EXTRANET_SUCCESS_URL_CONTAINS=search_reservations.html
BOOKING_EXTRANET_STORAGE_DIR=/data/booking_browser
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOOKING_EXTRANET_FERNET_KEY=
# human_assisted (default) | automatic — auto login max 1×/24h na celery-booking-browser
BOOKING_EXTRANET_CONNECT_MODE=human_assisted
BOOKING_EXTRANET_AUTO_CONNECT_MIN_HOURS=24
# noVNC (CAPTCHA u iframeu; Traefik PathPrefix + ForwardAuth)
BOOKING_EXTRANET_VNC_ENABLED=true
BOOKING_EXTRANET_VNC_DISPLAY=:99
BOOKING_EXTRANET_VNC_PUBLIC_PATH=/booking-vnc
BOOKING_EXTRANET_VNC_TOKEN_TTL_SECONDS=1200
BOOKING_EXTRANET_HEADED=true

# Tailscale exit node (Playwright egress = laptop residential IP)
# Headscale: https://hs-control.qubitsecured.online — generiraj auth key za uređaj tailscale-booking-browser
TS_LOGIN_SERVER=https://hs-control.qubitsecured.online
TS_HOSTNAME_BOOKING_BROWSER=tailscale-booking-browser
TS_AUTHKEY_BOOKING_BROWSER=
# Hostname laptopa u tailnetu koji oglašava exit node (npr. qubit-fi)
TAILSCALE_EXIT_NODE=
BOOKING_EXTRANET_TAILSCALE_EXIT_NODE=

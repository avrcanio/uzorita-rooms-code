# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Postgres/PostGIS (hetzner_net; lokalni alati i dalje mogu 127.0.0.1:5432)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgis
DB_PORT=5432

# Celery (infra-redis DB 1)
CELERY_BROKER_URL=redis://infra-redis:6379/1
CELERY_RESULT_BACKEND=redis://infra-redis:6379/1

DJANGO_CSRF_TRUSTED_ORIGINS=https://rooms.uzorita.hr

# Mailbox — Docker-mailserver (TLS hostname = MAIL_HOSTNAME u mailserver stacku)
MAILBOX_EMAIL=room_reservations@uzorita.hr
MAILBOX_PASSWORD=change-me-on-mailserver
# Prazno = spoji se na IMAP_HOST. Na istom hostu kao mailserver često 127.0.0.1 (hairpin NAT).
IMAP_CONNECT_HOST=
IMAP_TLS_SERVERNAME=
IMAP_HOST=mail.finestar.hr
IMAP_PORT=993
IMAP_USE_SSL=1
IMAP_FOLDER=INBOX
SMTP_HOST=mail.finestar.hr
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_USE_TLS=0
SMTP_USER=room_reservations@uzorita.hr
SMTP_PASSWORD=change-me-on-mailserver

# PaddleOCR FastAPI (hetzner_net service name)
PADDLE_OCR_BASE_URL=http://paddle-ocr-fastapi:8866
PADDLE_OCR_PREDICT_PATH=/predict
PADDLE_OCR_FILE_FIELD=file
PADDLE_OCR_TIMEOUT_SECONDS=90
PADDLE_OCR_REQUEST_FORMAT=json_images
# MRZ / OCR: SCAN_OCR_TRACE_LOG=1 → Django log (reception.scan, mrz_pipeline, OCRService).
# OCR_TRACE_LOG=1 → Paddle kontejner log (predict po liniji). U produkciji stavi 0.
SCAN_OCR_TRACE_LOG=1
OCR_TRACE_LOG=1
# OCR uzorci (original upload): default media/id_documents (MEDIA_ROOT). Prazno = ne spremaj.
# Sadrži osobne podatke — u produkciji postavi SCAN_OCR_SAMPLE_DIR= ; cijeli backend/app/media/ je u .gitignore.
SCAN_OCR_SAMPLE_DIR=media/id_documents
# MRZ (HR osobna poleđina = TD1, 3 linije ~30 znakova, puno '<'): backend uzima OCR linije
# duge >=20 znakova i probava TD3/TD2/TD1. Ako OCR vidi samo tekst iznad MRZ-a, MRZ neće
# proći — snimaj donji dio karte, dovoljna oštrina, bez jakog refleksa; u aplikaciji crop na MRZ.
# Drugi prolaz Paddlea na donjem MRZ izrezu (merge s punim kadrom): MRZ_OCR_SECOND_PASS=0 isključuje.
MRZ_OCR_SECOND_PASS=1
MRZ_CROP_HEIGHT_RATIO=0.32
MRZ_CROP_PREPROCESS=1
MRZ_CROP_MERGE_MARGIN_PX=8
# Smanji MRZ crop prije OpenCV (preporuka 1200–2000; 0=isključeno). Pomaže protiv Cloudflare timeouta.
MRZ_CROP_MAX_LONG_EDGE=1600
# Gornja granica piksela nakon upscale-a (nh*nw*up^2); ako je previsoko, upscale se automatski snizi.
MRZ_CROP_MAX_PIXELS_AFTER_UPSCALE=5000000
# Spremanje 4 MRZ debug JPG uz sken (sinkrono); 0=isključeno, 1=uključeno. Za produkciju ostavi 0.
MRZ_CROP_DEBUG_IMAGES=0
# Ako ROI + Paddle i dalje ne zadovoljavaju: sljedeći korak je odvojeni PR (Tesseract OCR-B ili SDK npr. BlinkID).

# Celery worker for Booking extranet Playwright tasks (needs Python 3.12+ for Django 6).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV DISPLAY=:99
WORKDIR /app

# Playwright Chromium + noVNC stack (Debian bookworm).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libpango-1.0-0 libcairo2 libasound2 libatspi2.0-0 \
    fonts-liberation fonts-noto-color-emoji \
    xvfb x11vnc novnc websockify curl \
    && rm -rf /var/lib/apt/lists/*

COPY app/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && playwright install chromium

COPY app /app
COPY scripts/booking-browser-entrypoint.sh /usr/local/bin/booking-browser-entrypoint.sh
RUN chmod +x /usr/local/bin/booking-browser-entrypoint.sh

CMD ["/usr/local/bin/booking-browser-entrypoint.sh"]
